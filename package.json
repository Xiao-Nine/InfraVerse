{
  "name": "infraverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "InfraVerse - 机房数字孪生与物料管理平台",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "mcp": "node --disable-warning=ExperimentalWarning server/mcp-stdio.js",
    "mcp:setup": "node --disable-warning=ExperimentalWarning scripts/pi-mcp-setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "vite": "^8.3.6"
  }
}
